# ==============================================================
# PromptStudio — Environment Variables (template)
# ==============================================================
# 1. Copy this file to `.env.local`  ->  cp .env.example .env.local
# 2. Fill in the values below.
# 3. Never commit `.env.local` — it is git-ignored via `.env*`.
#
# Full setup guide (local + Vercel): see ENVIRONMENT.md
# ==============================================================


# ─── REQUIRED ─────────────────────────────────────────────────

# Signs JWT session cookies. MUST be set in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# Google Gemini 2.5 Flash — the default generation model.
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=


# ─── DATABASE (REQUIRED) ──────────────────────────────────────
# Supabase Postgres. Create a free project at https://supabase.com, then:
# Project Settings → Database → Connection string → "Transaction pooler" URI
# (port 6543). Looks like:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Tables and the default admin are auto-created on first boot.
SUPABASE_DB_URL=


# ─── OPTIONAL: NVIDIA NIM ─────────────────────────────────────
# ONE key powers everything: extra text models (DeepSeek, Qwen, GLM, Kimi,
# GPT-OSS, Nemotron, Llama) AND in-app image generation (Flux, SD 3.5).
# Get a free key at https://build.nvidia.com/
NVIDIA_API_KEY=

# Optional SECOND key (e.g. from another NVIDIA account). Auto-used as a
# fallback for image generation when the primary key is rate-limited/rejected.
NVIDIA_API_KEY_FALLBACK=

# Base URL for NVIDIA's OpenAI-compatible text endpoint (rarely changed).
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional image-endpoint overrides. Defaults (verified live July 2026):
#   fast → black-forest-labs/flux.2-klein-4b · HQ → black-forest-labs/flux.1-dev
# NOTE: NVIDIA removed all stabilityai/* (SD) endpoints and qwen-image, and
# flux.1-schnell's backend is broken — don't point these at those paths.
# NVIDIA_FLUX_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.2-klein-4b
# NVIDIA_SD_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-dev
# NVIDIA_QWEN_URL=


# ─── GOOGLE SIGN-IN (recommended — the primary login method) ─
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   → Create Credentials → OAuth client ID → Web application
#   Authorized redirect URIs (add BOTH):
#     http://localhost:9080/api/auth/google/callback
#     https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails auto-promoted to admin on Google sign-in.
ADMIN_EMAILS=neilsahani55@gmail.com

# ─── FEEDBACK EMAIL NOTIFICATIONS (SMTP) ──────────────────────
# Sends every submitted feedback to your inbox. For Gmail:
# 1. Enable 2-Step Verification on the sender account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
#    and use it as SMTP_PASS (the normal password will NOT work).
SMTP_USER=
SMTP_PASS=
# Defaults: host smtp.gmail.com, port 465. Recipients default to
# neilsahani55@gmail.com (to) + promptstudios55@gmail.com (cc).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# FEEDBACK_EMAIL_TO=neilsahani55@gmail.com
# FEEDBACK_EMAIL_CC=promptstudios55@gmail.com

# ─── OPTIONAL: MORE FREE MEDIA PROVIDERS ──────────────────────
# Cloudflare Workers AI — unlocks 4 extra image models (FLUX Schnell, SDXL
# Lightning, SDXL Base, DreamShaper). Free: ~10k neurons/day.
# 1. Create a free account at https://dash.cloudflare.com
# 2. Account ID: dashboard right sidebar. Token: My Profile → API Tokens →
#    Create Token → "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Hugging Face — unlocks FLUX Schnell/Dev via HF plus VIDEO generation (beta:
# LTX-Video, Wan 2.2). Free accounts get small monthly inference credits;
# heavy use requires adding billing. Token: https://huggingface.co/settings/tokens
HF_TOKEN=

# ─── OPTIONAL: DEV ────────────────────────────────────────────
# Comma-separated LAN origins allowed to hit the Turbopack dev server from
# another device on your network. Leave blank unless you actually need it.
# ALLOWED_DEV_ORIGINS=http://192.168.1.10:9080
